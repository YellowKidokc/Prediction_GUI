{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision-request.v1",
  "type": "object",
  "required": ["item_ids", "decision"],
  "properties": {
    "item_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decision": {"enum": ["approved", "held", "rejected", "answered"]},
    "actor": {"type": "string"},
    "note": {"type": "string"}
  }
}
